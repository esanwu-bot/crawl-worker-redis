# Crawler Engine (Go) 环境变量示例（优先级高于 configs/config.yaml）
# 复制为 .env 或直接 export 后运行各命令。

# ---- 数据源 ----
CW_SOURCE=shikues
CW_MAX_PAGES=3

# ---- MySQL（结果层）----
CW_MYSQL_HOST=127.0.0.1
CW_MYSQL_PORT=3306
CW_MYSQL_USER=root
CW_MYSQL_PASS=root
CW_MYSQL_DB=shikues_crawler

# ---- Redis（任务层）----
CW_REDIS_HOST=127.0.0.1
CW_REDIS_PORT=6379
CW_REDIS_AUTH=
CW_REDIS_PREFIX=cw:
CW_CLAIM_IDLE_MS=30000

# ---- HTTP 抓取 ----
CW_DELAY_MS=200
CW_SSL_VERIFY=true
CW_CA_BUNDLE=

# ---- 代理池 ----
CW_PROXY_ENABLED=false
CW_PROXY_MODE=pool
CW_PROXY_LIST=user:pass@1.2.3.4:8080,1.2.3.4:8081

# ---- shikues ----
CW_API_BASE=https://api.shikues.com/api/product

# ---- maccms ----
CW_MACCMS_SITE=https://cj.lziapi.com
CW_MACCMS_API_BASE=https://cj.lziapi.com/api.php/provide/vod/
CW_MACCMS_PAGE_SIZE=20

# ---- 配置文件位置 ----
CW_CONFIG=configs/config.yaml
